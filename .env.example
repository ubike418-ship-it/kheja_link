# Supabase — Project Settings > API
# Safe to expose to the browser; protected by Row Level Security.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InZ5b2VmaG1tbWdzbnduZnp0dWFoIiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODg2ODAyNjEsImV4cCI6MjEwNDI1NjI2MX0.IPnUHIoOBTBYqbsUbZqCaEf4LIqIfeKjlikiwmYUIhI

# Canonical site URL. Used for auth email redirects, sitemap and OG tags.
# Local: http://localhost:3000   Production: https://your-app.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Payments (server-only — never NEXT_PUBLIC_)
# Paystack secret key. Without it the KSh 150 unlock runs in demo mode.
PAYSTACK_SECRET_KEY=
# Needed by the payment webhook to confirm an unlock. Server-only.
SUPABASE_SERVICE_ROLE_KEY=
# Optional. Only for testing the house hunting fee without Paystack: when
# "true" and PAYSTACK_SECRET_KEY is empty, the fee is activated without payment.
# Never set this in production.
PAYMENTS_DEMO_MODE=

# Scheduled job (/api/cron/daily). Vercel sends it automatically; add the same
# value as the CRON_SECRET GitHub secret so the hourly workflow can send alerts.
CRON_SECRET=

# Email notifications (optional) — https://resend.com
RESEND_API_KEY=
NOTIFY_FROM_EMAIL=Kheja_Link <alerts@your-domain>

# SMS notifications (optional) — https://africastalking.com
AFRICASTALKING_USERNAME=
AFRICASTALKING_API_KEY=
AFRICASTALKING_SENDER_ID=
