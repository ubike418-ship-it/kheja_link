<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Listings, photos and auth all come from Supabase over the network.
         Debug builds get this implicitly; release builds need it declared. -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- So the app can tell "you are offline" apart from "something broke",
         which are very different messages on a patchy mobile connection. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE"/>

    <!-- The only runtime permission: location, asked when a landlord taps
         "pin my location" in the listing editor to drop the house's exact pin
         for Google Maps. Never in the background.

         Deliberately NOT declared (Google Play policy, and fewer prompts):
           * photos/videos/storage — the Android photo picker needs none
           * camera/microphone — taking a photo or video hands off to the
             phone's own camera app, which needs neither in this app
           * notifications — every alert lives in the in-app Inbox; the app
             posts no system notifications -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION"/>
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION"/>

    <!-- A camera is useful but not required to install the app. -->
    <uses-feature android:name="android.hardware.camera" android:required="false"/>
    <uses-feature android:name="android.hardware.location.gps" android:required="false"/>

    <!-- allowBackup/fullBackupContent off: the signed-in session lives in app
         storage, and a cloud or adb backup must never carry it to another
         device. Cleartext HTTP is refused; everything the app talks to is HTTPS. -->
    <application
        android:label="Kheja_Link"
        android:name="${applicationName}"
        android:icon="@mipmap/launcher_icon"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:usesCleartextTraffic="false">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>

            <!-- Supabase sends people back here after they confirm their email
                 or reset their password. The scheme must match
                 SupabaseConfig.authRedirect and be listed under
                 Authentication → URL Configuration in Supabase. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="ke.co.khejalink" android:host="login-callback"/>
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>

    <!-- Android 11+ requires declaring the intents we hand off to. Without
         these, calling a landlord, opening WhatsApp/Maps or sending an email
         silently fails on newer devices. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:scheme="https"/>
        </intent>
        <intent>
            <action android:name="android.intent.action.DIAL"/>
            <data android:scheme="tel"/>
        </intent>
        <intent>
            <action android:name="android.intent.action.SENDTO"/>
            <data android:scheme="mailto"/>
        </intent>
    </queries>
</manifest>
